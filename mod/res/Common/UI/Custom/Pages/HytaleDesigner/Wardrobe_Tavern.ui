// Made by dev/tools/render-wardrobe.py from Wardrobe.ui for the Tavern wardrobe: edit Wardrobe.ui, then run the script.
$C = "../../Common.ui";

@HeadStyle = LabelStyle(
  FontSize: 12,
  VerticalAlignment: Center,
  RenderUppercase: true,
  TextColor: #c7ae7a,
  FontName: "Secondary",
  RenderBold: true,
  LetterSpacing: 0.5
);

@NameStyle = LabelStyle(
  FontSize: 12,
  Wrap: true,
  TextColor: #ecdcb8,
  FontName: "Secondary",
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

$C.@PageOverlay {
  LayoutMode: Middle;

  Group {
    Anchor: (Width: 1200, Height: 756);

    Label {
      Anchor: (Left: 0, Top: 0, Width: 1200, Height: 40);
      Text: "Wardrobe";
      Style: (...$C.@TitleStyle, FontSize: 22, HorizontalAlignment: Center, LetterSpacing: 1);
    }

    Group {
      Anchor: (Left: 0, Top: 40, Width: 1200, Height: 690);
      Background: (TexturePath: "Wardrobe_Tavern.png");

      Label {
        Anchor: (Left: 366, Top: 87, Width: 300, Height: 18);
        Text: "Hytale skins";
        Style: @HeadStyle;
      }

      // the player's own skin, worn whenever no Locker skin is
      Group {
        Anchor: (Left: 358, Top: 85, Width: 94, Height: 200);


        Button #OwnCard {
          Anchor: (Left: 0, Top: 0, Width: 94, Height: 200);
          Style: (
            Default: (Background: #000000(0)),
            Hovered: (Background: (TexturePath: "HoverGlow.png")),
            Pressed: (Background: (TexturePath: "HoverGlow.png")),
            Sounds: $C.@ButtonSounds
          );

          Group #OwnHang {
            Anchor: (Left: 0, Top: 0, Width: 94, Height: 200);

            Group #OwnHanger {
              Anchor: (Left: 16, Top: 23, Width: 63, Height: 86);
              Background: (TexturePath: "Hanger.png");
            }

            AssetImage #OwnPic {
              Anchor: (Left: 18, Top: 63, Width: 57, Height: 92);
              FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
            }

            Label #OwnName {
              Anchor: (Left: 0, Top: 162, Width: 94, Height: 34);
              Style: @NameStyle;
            }
          }
        }
      }

      // the preset slots to come: bare hangers beside the own skin (the in-game presets hang here once Hytale allows sign-in)
      Group #Presets {
        Anchor: (Left: 452, Top: 85, Width: 376, Height: 200);

        Group {
          Anchor: (Left: 16, Top: 23, Width: 63, Height: 86);
          Background: (TexturePath: "HangerEmpty.png");
        }

        Group {
          Anchor: (Left: 110, Top: 23, Width: 63, Height: 86);
          Background: (TexturePath: "HangerEmpty.png");
        }

        Group {
          Anchor: (Left: 204, Top: 23, Width: 63, Height: 86);
          Background: (TexturePath: "HangerEmpty.png");
        }

        Group {
          Anchor: (Left: 298, Top: 23, Width: 63, Height: 86);
          Background: (TexturePath: "HangerEmpty.png");
        }

        Label {
          Anchor: (Left: 0, Top: 118, Width: 376, Height: 18);
          Text: "Your presets will hang here";
          Style: (...@NameStyle, TextColor: #c7ae7a);
        }

        Label {
          Anchor: (Left: 0, Top: 138, Width: 376, Height: 18);
          Text: "coming soon";
          Style: (...@NameStyle, TextColor: #8f7c58, RenderItalics: true, RenderBold: false);
        }
      }

      Group #Grid {
        LayoutMode: LeftScrolling;
        MouseWheelScrollBehaviour: HorizontalOnly;
        ScrollbarStyle: (
          Spacing: 0,
          Size: 3,
          Handle: #c7ae7a(0.5),
          HoveredHandle: #ecdcb8(0.8),
          DraggedHandle: #ecdcb8(0.9),
          OnlyVisibleWhenHovered: true
        );
        Anchor: (Left: 358, Top: 286, Width: 470, Height: 200);
      }

      Label #Empty {
        Anchor: (Left: 358, Top: 286, Width: 470, Height: 200);
        Text: "No saved skins";
        Style: (...@HeadStyle, HorizontalAlignment: Center);
        Visible: false;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Left: 366, Top: 280, Width: 458, Height: 28);

        Label {
          Text: "Designer skins";
          Style: @HeadStyle;
        }

        Label #Count {
          Padding: (Left: 10);
          Text: "0";
          Style: (...@HeadStyle, TextColor: #8f7c58);
        }

        Group { FlexWeight: 1; }

      }

      // pages: a control made on each door's inside (an arrow carved or inlaid, or the door's own hardware), rendered in the doors'
      // angle; place and size as render-wardrobe.py prints them

    }

    Label #Status {
      Anchor: (Left: 0, Top: 732, Width: 1200, Height: 22);
      Style: (FontSize: 14, HorizontalAlignment: Center, VerticalAlignment: Center, TextColor: #96a9be);
    }
  }
}

$C.@BackButton {}
