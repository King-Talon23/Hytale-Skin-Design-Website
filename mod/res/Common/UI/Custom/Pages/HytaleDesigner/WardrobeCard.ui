// One Locker skin on its hook on the wardrobe's bottom rack. The worn one's hanger is lifted off the rail; the skin hangs on a coat hanger (hook over the
// rail, wooden bar on its shoulders); the plugin lifts it with its hanger and grows it while the pointer is on it or it is worn. Art: dev/tools/render-wardrobe.py.
$C = "../../Common.ui";

@NameStyle = LabelStyle(
  FontSize: 12,
  Wrap: true,
  TextColor: #ecdcb8,
  FontName: "Secondary",
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

Group {
  Anchor: (Width: 94, Height: 200);


  Button #Card {
    Anchor: (Left: 0, Top: 0, Width: 94, Height: 200);
    Style: (
      Default: (Background: #000000(0)),
      Hovered: (Background: (TexturePath: "HoverGlow.png")),
      Pressed: (Background: (TexturePath: "HoverGlow.png")),
      Sounds: $C.@ButtonSounds
    );

    Group #Hang {
      Anchor: (Left: 0, Top: 0, Width: 94, Height: 200);

      Group #Hanger {
        Anchor: (Left: 16, Top: 23, Width: 63, Height: 86);
        Background: (TexturePath: "Hanger.png");
      }

      AssetImage #Pic {
        Anchor: (Left: 4, Top: 68, Width: 86, Height: 86);
        FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
      }

      Group #Fav {
        Anchor: (Left: 72, Top: 60, Width: 16, Height: 16);
        Background: (TexturePath: "Star.png");
        Visible: false;
      }

      Label #Name {
        Anchor: (Left: 0, Top: 162, Width: 94, Height: 34);
        Style: @NameStyle;
      }
    }
  }
}
